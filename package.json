{
  "name": "react-native-face-auth",
  "version": "0.1.0",
  "description": "Offline facial recognition + liveness detection for React Native (Android & iOS). Lightweight, on-device, open-source.",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index.tsx",
  "source": "src/index.tsx",
  "files": [
    "src",
    "lib",
    "models",
    "android",
    "ios",
    "*.podspec",
    "!**/__tests__",
    "!**/__mocks__"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "build": "tsc -p tsconfig.build.json"
  },
  "keywords": [
    "react-native",
    "face-recognition",
    "liveness-detection",
    "edge-ai",
    "tflite",
    "offline-first",
    "nhai-hackathon",
    "hackathon-7",
    "nhai",
    "anti-spoofing",
    "biometrics",
    "mediapipe"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-vision-camera": ">=4.0.0",
    "react-native-fast-tflite": ">=1.3.0",
    "vision-camera-resize-plugin": ">=3.0.0",
    "react-native-mediapipe": ">=0.4.0",
    "react-native-worklets-core": ">=1.3.0",
    "react-native-mmkv": ">=2.0.0",
    "@react-native-community/netinfo": ">=11.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/__tests__/**/*.test.ts"]
  }
}
